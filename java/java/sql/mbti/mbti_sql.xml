<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mbti">

	<resultMap id="mbtiVo" type="com.spring.mbti.vo.MbtiVo">
    	<result property="mbtiType" column="MBTI_TYPE"/>
    	<result property="mbtiNum" column="MBTI_NUM"/>
    	<result property="mbtiComment" column="MBTI_COMMENT"/>
	</resultMap>

	<select id="mbtiList" resultMap="mbtiVo">
		SELECT
			MBTI_TYPE,
			MBTI_NUM,
			MBTI_COMMENT
		FROM
			BOARD
		ORDER BY MBTI_NUM ASC
	</select>
	
</mapper>
